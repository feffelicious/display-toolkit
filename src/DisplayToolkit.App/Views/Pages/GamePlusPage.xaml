<UserControl x:Class="DisplayToolkit.App.Views.Pages.GamePlusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DisplayToolkit.App.Controls"
             xmlns:main="clr-namespace:DisplayToolkit.App.ViewModels.Main"
             xmlns:monitors="clr-namespace:DisplayToolkit.Core.Monitors;assembly=DisplayToolkit.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance main:GamePlusPageViewModel}">
  <StackPanel>
    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8"
               Text="Overlays drawn by the monitor itself. They work with any input and never appear in screenshots or recordings." />

    <controls:SettingsCard Header="Crosshair" HeaderIcon="&#xF272;" Visibility="{Binding Crosshair, Converter={StaticResource VisibleWhenNotNull}}">
      <ComboBox MinWidth="200" ItemsSource="{Binding Crosshair.Options}" DisplayMemberPath="Name"
                SelectedItem="{Binding Crosshair.SelectedOption, Mode=TwoWay}" AutomationProperties.Name="Crosshair" />
    </controls:SettingsCard>

    <controls:SettingsCard Header="FPS counter" HeaderIcon="&#xF404;" Description="The refresh rate the monitor is receiving."
                           Visibility="{Binding FpsCounter, Converter={StaticResource VisibleWhenNotNull}}">
      <ItemsControl Width="240" Style="{StaticResource SegmentedChoices}" ItemsSource="{Binding FpsCounter.Choices}" />
    </controls:SettingsCard>

    <controls:SettingsCard Header="Timer" HeaderIcon="&#xE916;" Description="Counts down on screen, for example a respawn timer."
                           Visibility="{Binding Timer, Converter={StaticResource VisibleWhenNotNull}}">
      <ComboBox MinWidth="200" ItemsSource="{Binding Timer.Options}" DisplayMemberPath="Name"
                SelectedItem="{Binding Timer.SelectedOption, Mode=TwoWay}" AutomationProperties.Name="Timer" />
    </controls:SettingsCard>

    <controls:SettingsCard Header="Display alignment" HeaderIcon="&#xE80A;" Description="Alignment lines for lining up several monitors."
                           Visibility="{Binding DisplayAlignment, Converter={StaticResource VisibleWhenNotNull}}">
      <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding DisplayAlignment.Toggled, Mode=TwoWay}" AutomationProperties.Name="Display alignment" />
    </controls:SettingsCard>

    <controls:SettingsCard Header="Position" HeaderIcon="&#xE7C2;" Description="Moves the FPS counter and timer. Hold an arrow to keep going."
                           Visibility="{Binding CanMoveOverlays, Converter={StaticResource VisibleWhenTrue}}">
      <!-- Repeat buttons: the monitor only takes small steps, so holding an arrow sends them every 50 ms. -->
      <Grid>
        <Grid.Resources>
          <Style x:Key="Step" TargetType="RepeatButton" BasedOn="{StaticResource {x:Type RepeatButton}}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Delay" Value="300" />
            <Setter Property="Interval" Value="50" />
            <Setter Property="Command" Value="{Binding MoveOverlaysCommand}" />
          </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
          <RowDefinition /><RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
        </Grid.ColumnDefinitions>
        <RepeatButton Grid.Column="1" Style="{StaticResource Step}" CommandParameter="{x:Static monitors:OverlayDirection.Up}" AutomationProperties.Name="Move up">
          <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE70E;" />
        </RepeatButton>
        <RepeatButton Grid.Row="1" Style="{StaticResource Step}" CommandParameter="{x:Static monitors:OverlayDirection.Left}" AutomationProperties.Name="Move left">
          <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE76B;" />
        </RepeatButton>
        <RepeatButton Grid.Row="1" Grid.Column="1" Style="{StaticResource Step}" CommandParameter="{x:Static monitors:OverlayDirection.Down}" AutomationProperties.Name="Move down">
          <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE70D;" />
        </RepeatButton>
        <RepeatButton Grid.Row="1" Grid.Column="2" Style="{StaticResource Step}" CommandParameter="{x:Static monitors:OverlayDirection.Right}" AutomationProperties.Name="Move right">
          <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE76C;" />
        </RepeatButton>
      </Grid>
    </controls:SettingsCard>

    <!-- ======================================================== Target mode (drawn by the app, not the monitor) -->
    <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Focus" />

    <controls:SettingsExpander Header="Target mode" HeaderIcon="&#xE7C4;" IsExpanded="True"
                               Description="Dims every screen except the window you're using. Also in quick settings and the tray menu.">
      <controls:SettingsExpander.HeaderContent>
        <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding IsTargetModeOn, Mode=TwoWay}" AutomationProperties.Name="Target mode" />
      </controls:SettingsExpander.HeaderContent>
      <controls:SettingsCard IsNested="True" Header="Dim the rest by">
        <StackPanel Orientation="Horizontal">
          <Slider Width="200" VerticalAlignment="Center" Minimum="10" Maximum="95" IsMoveToPointEnabled="True"
                  IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding TargetModeDim, Mode=TwoWay}" AutomationProperties.Name="Dim the rest by" />
          <TextBlock Width="44" VerticalAlignment="Center" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding TargetModeDim, StringFormat={}{0:0} %}" />
        </StackPanel>
      </controls:SettingsCard>
    </controls:SettingsExpander>
  </StackPanel>
</UserControl>
