<UserControl x:Class="DisplayToolkit.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DisplayToolkit.App.Controls"
             xmlns:main="clr-namespace:DisplayToolkit.App.ViewModels.Main"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance main:SettingsPageViewModel}">
  <UserControl.Resources>
    <DataTemplate x:Key="ShortcutRow" DataType="{x:Type main:ShortcutRowViewModel}">
      <controls:SettingsCard Header="{Binding Name}" HeaderIcon="{Binding Glyph}" IsNested="{Binding IsNested}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="Another app uses this shortcut"
                     Visibility="{Binding IsTaken, Converter={StaticResource VisibleWhenTrue}}" />
          <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="None"
                     Visibility="{Binding HasShortcut, Converter={StaticResource VisibleWhenFalse}}" />
          <controls:ShortcutRecorder Keys="{Binding Keys}" Command="{Binding RecordCommand}" AutomationProperties.Name="{Binding Name}" />
          <Button Margin="4,0,0,0" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove shortcut"
                  AutomationProperties.Name="Remove shortcut" Command="{Binding RecordCommand}" CommandParameter="{x:Null}"
                  Visibility="{Binding HasShortcut, Converter={StaticResource VisibleWhenTrue}}" />
        </StackPanel>
      </controls:SettingsCard>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>

    <!-- ======================================================== General -->
    <TextBlock Style="{StaticResource SettingsGroupHeader}" Margin="0,0,0,8" Text="General" />

    <controls:SettingsCard Header="Start with Windows" HeaderIcon="&#xE7E8;" Description="Display Toolkit waits in the notification area.">
      <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows" />
    </controls:SettingsCard>

    <controls:SettingsCard Header="App theme" HeaderIcon="&#xE790;">
      <ComboBox MinWidth="200" ItemsSource="{Binding Themes}" DisplayMemberPath="Name"
                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" AutomationProperties.Name="App theme" />
    </controls:SettingsCard>

    <controls:SettingsExpander Header="Back up settings" HeaderIcon="&#xE8F1;"
                               Description="Profiles, rules, the quick settings layout and preferences, in one file. Handy for a new PC.">
      <StackPanel>
        <controls:SettingsCard IsNested="True" Header="Export" Description="Save everything to a file.">
          <Button Padding="12,4" Content="Export…" Command="{Binding ExportSettingsCommand}" />
        </controls:SettingsCard>
        <controls:SettingsCard IsNested="True" Header="Import" Description="Replace everything with a file you exported before.">
          <Button Padding="12,4" Content="Import…" Command="{Binding ImportSettingsCommand}" />
        </controls:SettingsCard>
        <TextBlock Margin="56,8,16,10" Style="{StaticResource CaptionText}" Text="{Binding TransferStatus}" TextWrapping="Wrap"
                   Visibility="{Binding TransferStatus, Converter={StaticResource VisibleWhenNotNull}}" />
      </StackPanel>
    </controls:SettingsExpander>

    <!-- ======================================================== Shortcuts -->
    <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Shortcuts" />

    <ItemsControl ItemsSource="{Binding Shortcuts}" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />

    <controls:SettingsExpander Header="Switch input" HeaderIcon="&#xEA4E;" Description="A shortcut for each of the monitor's inputs."
                               Visibility="{Binding HasInputShortcuts, Converter={StaticResource VisibleWhenTrue}}">
      <ItemsControl ItemsSource="{Binding InputShortcuts}" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
    </controls:SettingsExpander>

    <controls:SettingsCard Header="Scroll over the tray icon" HeaderIcon="&#xE962;" Description="Changes brightness with the mouse wheel.">
      <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding ScrollOverTrayIcon, Mode=TwoWay}"
                AutomationProperties.Name="Scroll over the tray icon" />
    </controls:SettingsCard>

    <controls:SettingsCard Header="Show changes from shortcuts" HeaderIcon="&#xE7F4;"
                           Description="A small overlay above the taskbar confirms what a shortcut or the mouse wheel changed.">
      <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding ShowShortcutOverlay, Mode=TwoWay}"
                AutomationProperties.Name="Show changes from shortcuts" />
    </controls:SettingsCard>

    <!-- ======================================================== Location -->
    <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Location" />

    <controls:SettingsExpander Header="Location for sunrise and sunset" HeaderIcon="&#xE81D;" IsExpanded="True"
                               Description="{Binding LocationSummary}">
      <StackPanel>
        <controls:SettingsCard IsNested="True" Header="Use Windows location"
                               Description="Rounded to about a kilometer and kept on this PC.">
          <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding UseWindowsLocation, Mode=TwoWay}"
                    AutomationProperties.Name="Use Windows location" />
        </controls:SettingsCard>
        <controls:SettingsCard IsNested="True" Header="Or enter it yourself" Description="Latitude and longitude in degrees. North and east are positive.">
          <StackPanel Orientation="Horizontal">
            <TextBox Width="96" Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Latitude" />
            <TextBox Width="96" Margin="8,0" Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Longitude" />
            <Button Padding="12,4" Content="Use this location" Command="{Binding SaveLocationCommand}" />
          </StackPanel>
        </controls:SettingsCard>
        <controls:SettingsCard IsNested="True" Header="Location settings in Windows" Description="Turn on location for desktop apps."
                               IsClickEnabled="True" Command="{Binding OpenLocationSettingsCommand}" />
      </StackPanel>
    </controls:SettingsExpander>

    <!-- ======================================================== Monitor -->
    <StackPanel Visibility="{Binding Monitor, Converter={StaticResource VisibleWhenNotNull}}">
      <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Monitor" />

      <controls:SettingsCard Header="Power light" HeaderIcon="&#xE7E8;" Description="The light on the monitor's power button."
                             Visibility="{Binding PowerIndicator, Converter={StaticResource VisibleWhenNotNull}}">
        <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding PowerIndicator.Toggled, Mode=TwoWay}" AutomationProperties.Name="Power light" />
      </controls:SettingsCard>
      <controls:SettingsCard Header="Lock menu buttons" HeaderIcon="&#xE72E;" Description="Ignores the monitor's own buttons. Display Toolkit still works."
                             Visibility="{Binding KeyLock, Converter={StaticResource VisibleWhenNotNull}}">
        <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding KeyLock.Toggled, Mode=TwoWay}" AutomationProperties.Name="Lock menu buttons" />
      </controls:SettingsCard>
      <controls:SettingsCard Header="Lock power button" HeaderIcon="&#xE72E;"
                             Visibility="{Binding PowerKeyLock, Converter={StaticResource VisibleWhenNotNull}}">
        <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding PowerKeyLock.Toggled, Mode=TwoWay}" AutomationProperties.Name="Lock power button" />
      </controls:SettingsCard>
      <controls:SettingsCard Header="Find input automatically" HeaderIcon="&#xEA4E;" Description="Switches to whichever input has a signal."
                             Visibility="{Binding InputAutoDetection, Converter={StaticResource VisibleWhenNotNull}}">
        <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding InputAutoDetection.Toggled, Mode=TwoWay}" AutomationProperties.Name="Find input automatically" />
      </controls:SettingsCard>
    </StackPanel>

    <!-- ======================================================== About -->
    <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="About" />

    <controls:SettingsExpander Header="Display Toolkit" HeaderIcon="&#xE946;" IsExpanded="True">
      <controls:SettingsExpander.HeaderContent>
        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Version, StringFormat=Version {0}}" />
      </controls:SettingsExpander.HeaderContent>
      <StackPanel>
        <controls:SettingsCard IsNested="True" Header="Check for updates" Description="{Binding UpdateStatus}">
          <StackPanel Orientation="Horizontal">
            <Button Margin="0,0,8,0" Padding="12,4" Content="Download" Style="{DynamicResource AccentButtonStyle}"
                    Command="{Binding DownloadUpdateCommand}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource VisibleWhenTrue}}" />
            <Button Margin="0,0,12,0" Padding="12,4" Content="Check now" Command="{Binding CheckForUpdatesNowCommand}" />
            <CheckBox Style="{StaticResource ToggleSwitch}" Tag="Labeled" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                      AutomationProperties.Name="Check for updates automatically" ToolTip="Check once a day" />
          </StackPanel>
        </controls:SettingsCard>
        <controls:SettingsCard IsNested="True" Header="Source code and issues" Description="Open source under the MIT license."
                               IsClickEnabled="True" Command="{Binding OpenRepositoryCommand}" />
        <controls:SettingsCard IsNested="True" Header="Log and settings folder" Description="Attach display-toolkit.log to bug reports."
                               IsClickEnabled="True" Command="{Binding OpenLogFolderCommand}" />
        <controls:SettingsCard IsNested="True" Header="Not affiliated with ASUS"
                               Description="ASUS, ROG and GameVisual are trademarks of ASUSTeK Computer Inc." />
      </StackPanel>
    </controls:SettingsExpander>
  </StackPanel>
</UserControl>
