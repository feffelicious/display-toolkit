<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DisplayToolkit.App</RootNamespace>
    <AssemblyName>DisplayToolkit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF0001: the Fluent ThemeMode API is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!--
    Releases are one self-contained DisplayToolkit.exe: nothing to install, not even .NET. Not compressed inside: the
    release zip compresses it just as well, and an uncompressed exe uses half the memory (no unpacking at start).
  -->
  <PropertyGroup Label="Publish">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisplayToolkit.Automation\DisplayToolkit.Automation.csproj" />
    <ProjectReference Include="..\DisplayToolkit.Core\DisplayToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
