<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DisplayToolkit.App.Controls"
                    xmlns:tiles="clr-namespace:DisplayToolkit.App.ViewModels.Tiles">

  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!--
    Pending dots (band and tiles) appear only if a write is still unconfirmed after 300 ms, then pulse.
    Two storyboards: one reveals the dot's container, the other pulses the dot itself.
  -->

  <!-- ============================================================ Focus ring -->

  <Style TargetType="controls:FocusRingVisual">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:FocusRingVisual">
          <Grid Margin="-3" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border BorderThickness="2" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                    CornerRadius="{Binding OuterCornerRadius, RelativeSource={RelativeSource TemplatedParent}}" />
            <Border Margin="2" BorderThickness="1" BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}"
                    CornerRadius="{Binding InnerCornerRadius, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Brightness band -->

  <Style TargetType="controls:BrightnessBand">
    <Setter Property="Height" Value="40" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="Brightness" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:BrightnessBand">
          <Grid>
            <Grid x:Name="Body">
              <!-- Clip the fill to the rounded track. -->
              <Grid.OpacityMask>
                <VisualBrush>
                  <VisualBrush.Visual>
                    <Border Background="Black" CornerRadius="6"
                            Width="{Binding ActualWidth, ElementName=Body}"
                            Height="{Binding ActualHeight, ElementName=Body}" />
                  </VisualBrush.Visual>
                </VisualBrush>
              </Grid.OpacityMask>
              <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" />
              <Border x:Name="PART_Fill" HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}" />
              <TextBlock Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                         FontFamily="{StaticResource IconFont}" FontSize="16"
                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                         Text="{TemplateBinding Glyph}" />
              <StackPanel Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Grid x:Name="PendingDot" Width="6" Height="6" Margin="0,0,8,0" Opacity="0" VerticalAlignment="Center">
                  <Ellipse x:Name="PendingPulse" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                </Grid>
                <TextBlock x:Name="FailedGlyph" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                           FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="&#xE7BA;" />
                <TextBlock FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}}" />
              </StackPanel>
            </Grid>
            <Border x:Name="Stroke" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <controls:FocusRingVisual x:Name="Ring" CornerRadius="9" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasFailed" Value="True">
              <Setter TargetName="FailedGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="controls:FocusRing.IsVisible" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPending" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="BandAppear">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PendingDot" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.3" Duration="0" />
                  </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard x:Name="BandPulse">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PendingPulse" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.25" BeginTime="0:0:0.3" Duration="0:0:0.6" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="BandAppear" />
                <StopStoryboard BeginStoryboardName="BandPulse" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Quick tile -->

  <!-- Transparent hit area with the Fluent hover/press overlay. Tag carries the corner radius. -->
  <Style x:Key="TilePartButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    <Setter Property="Tag">
      <Setter.Value>
        <CornerRadius>4</CornerRadius>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Overlay" Background="Transparent" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            <controls:FocusRingVisual x:Name="Ring" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="controls:FocusRing.IsVisible" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:QuickTile">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:QuickTile">
          <StackPanel>
            <Grid Height="48">
              <Border x:Name="Plate" CornerRadius="4" BorderThickness="1"
                      Background="{DynamicResource ControlFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
              <Grid x:Name="Parts">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition x:Name="ChevronColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Button x:Name="Main" Grid.ColumnSpan="2" Style="{StaticResource TilePartButton}"
                        Command="{TemplateBinding Command}"
                        AutomationProperties.Name="{TemplateBinding Label}">
                  <Grid>
                    <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Glyph}" />
                    <!-- No Fluent glyph exists for HDR: outlined text instead. -->
                    <Border x:Name="HdrGlyph" Visibility="Collapsed" Height="16" Padding="3,0" CornerRadius="3" BorderThickness="1.5"
                            BorderBrush="{TemplateBinding Foreground}">
                      <TextBlock VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Text="HDR" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                  </Grid>
                </Button>

                <Rectangle x:Name="Divider" Grid.Column="1" Width="1" Margin="0,10" HorizontalAlignment="Left" Visibility="Collapsed"
                           Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <Button x:Name="Chevron" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource TilePartButton}"
                        Command="{TemplateBinding SecondaryCommand}">
                  <Button.Tag>
                    <CornerRadius>0,4,4,0</CornerRadius>
                  </Button.Tag>
                  <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE76C;" Foreground="{TemplateBinding Foreground}" />
                </Button>

                <!-- Pickers show a chevron too, but the whole tile is one button. -->
                <TextBlock x:Name="PickerChevron" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE76C;" Foreground="{TemplateBinding Foreground}" />
              </Grid>

              <Grid x:Name="PendingDot" Width="6" Height="6" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Opacity="0" IsHitTestVisible="False">
                <Ellipse x:Name="PendingPulse" Fill="{TemplateBinding Foreground}" />
              </Grid>

              <!-- Edit mode: unpin badge overlapping the top-right corner. -->
              <Button x:Name="UnpinBadge" Width="22" Height="22" Margin="0,-8,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Visibility="Collapsed" Command="{TemplateBinding RemoveCommand}" Cursor="Hand" Focusable="False"
                      AutomationProperties.Name="Remove from quick settings">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Disc" CornerRadius="11" BorderThickness="1"
                            Background="{DynamicResource ControlSolidFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="10"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xE77A;" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Disc" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <Border x:Name="FailedBadge" Width="20" Height="20" Margin="0,-8,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                      CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False"
                      Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="&#xE7BA;" />
              </Border>
            </Grid>

            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{TemplateBinding Label}" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="Kind" Value="{x:Static tiles:TileKind.Split}">
              <Setter TargetName="ChevronColumn" Property="Width" Value="30" />
              <Setter TargetName="Main" Property="Grid.ColumnSpan" Value="1" />
              <Setter TargetName="Main" Property="Tag">
                <Setter.Value>
                  <CornerRadius>4,0,0,4</CornerRadius>
                </Setter.Value>
              </Setter>
              <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
              <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Kind" Value="{x:Static tiles:TileKind.Picker}">
              <Setter TargetName="ChevronColumn" Property="Width" Value="30" />
              <Setter TargetName="PickerChevron" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Glyph" Value="HDR">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="HdrGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsOn" Value="True">
              <Setter TargetName="Plate" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Plate" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="Divider" Property="Fill" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="HasFailed" Value="True">
              <Setter TargetName="FailedBadge" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEditing" Value="True">
              <Setter TargetName="UnpinBadge" Property="Visibility" Value="Visible" />
              <Setter TargetName="FailedBadge" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Parts" Property="IsHitTestVisible" Value="False" />
              <Setter Property="Cursor" Value="SizeAll" />
            </Trigger>
            <Trigger Property="IsPending" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="TileAppear">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PendingDot" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.3" Duration="0" />
                  </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard x:Name="TilePulse">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PendingPulse" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.25" BeginTime="0:0:0.3" Duration="0:0:0.6" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="TileAppear" />
                <StopStoryboard BeginStoryboardName="TilePulse" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Settings card -->

  <Style TargetType="controls:SettingsCard">
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingsCard">
          <Grid>
            <Border x:Name="Card" CornerRadius="4" BorderThickness="1"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
            <Rectangle x:Name="Divider" Height="1" VerticalAlignment="Top" Visibility="Collapsed"
                       Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IconColumn" Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ChevronColumn" Width="0" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Icon" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="20"
                         Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding HeaderIcon}" />
              <Border x:Name="HdrIcon" Visibility="Collapsed" Height="18" Padding="3,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      CornerRadius="3" BorderThickness="1.5" BorderBrush="{TemplateBinding Foreground}">
                <TextBlock VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Text="HDR" Foreground="{TemplateBinding Foreground}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Header}" />
                <TextBlock x:Name="DescriptionText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{TemplateBinding Description}" />
              </StackPanel>
              <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}"
                         FontSize="12" Foreground="{TemplateBinding Foreground}" Text="&#xE76C;" />
            </Grid>
            <controls:FocusRingVisual x:Name="Ring" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HeaderIcon" Value="{x:Null}">
              <Setter TargetName="IconColumn" Property="Width" Value="0" />
            </Trigger>
            <Trigger Property="HeaderIcon" Value="HDR">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="HdrIcon" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Description" Value="{x:Null}">
              <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsClickEnabled" Value="True">
              <Setter TargetName="ChevronColumn" Property="Width" Value="28" />
              <Setter Property="Focusable" Value="True" />
              <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsClickEnabled" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsClickEnabled" Value="True" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </MultiTrigger>
            <!-- Nested in an expander: flat row with a divider, indented under the expander's icon. -->
            <Trigger Property="IsNested" Value="True">
              <Setter TargetName="Card" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
              <Setter Property="Padding" Value="52,10,16,10" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="MinHeight" Value="52" />
            </Trigger>
            <Trigger Property="controls:FocusRing.IsVisible" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Settings expander -->

  <Style TargetType="controls:SettingsExpander">
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingsExpander">
          <StackPanel>
            <ToggleButton x:Name="HeaderButton" MinHeight="68" FocusVisualStyle="{x:Null}" controls:FocusRing.IsEnabled="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="{TemplateBinding Header}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <Border x:Name="Card" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <ContentPresenter Margin="16,12" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    <controls:FocusRingVisual x:Name="Ring" Visibility="Collapsed" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Card" Property="CornerRadius" Value="4,4,0,0" />
                    </Trigger>
                    <Trigger Property="controls:FocusRing.IsVisible" Value="True">
                      <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="IconColumn" Width="36" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding HeaderIcon}" />
                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Header}" />
                  <TextBlock x:Name="DescriptionText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Text="{TemplateBinding Description}" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Content="{TemplateBinding HeaderContent}" />
                <TextBlock x:Name="Chevron" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{TemplateBinding Foreground}" Text="&#xE70D;" />
              </Grid>
            </ToggleButton>
            <Border x:Name="Body" Visibility="Collapsed" CornerRadius="0,0,4,4" BorderThickness="1,0,1,1"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <ContentPresenter />
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
              <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
            </Trigger>
            <Trigger Property="Description" Value="{x:Null}">
              <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HeaderIcon" Value="{x:Null}">
              <Setter TargetName="IconColumn" Property="Width" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Shortcut recorder -->

  <!-- A key of a shortcut, drawn as a keycap. -->
  <Style x:Key="Keycap" TargetType="Border">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
  </Style>

  <Style TargetType="controls:ShortcutRecorder">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ShortcutRecorder">
          <Grid MinHeight="32">
            <Border x:Name="Body" CornerRadius="4" BorderThickness="1" Background="Transparent" BorderBrush="Transparent" />
            <!-- Keycaps, or "Not set" -->
            <StackPanel x:Name="Display" Margin="4,2" Orientation="Horizontal" VerticalAlignment="Center">
              <ItemsControl x:Name="Caps" ItemsSource="{TemplateBinding Keys}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Keycap}">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="14"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE70F;" />
            </StackPanel>
            <!-- Recording -->
            <StackPanel x:Name="Prompt" Margin="12,0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Press a shortcut" />
              <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="Esc to cancel, Backspace to remove" />
            </StackPanel>
            <controls:FocusRingVisual x:Name="Ring" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsRecording" Value="True">
              <Setter TargetName="Display" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Prompt" Property="Visibility" Value="Visible" />
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
              <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="controls:FocusRing.IsVisible" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
