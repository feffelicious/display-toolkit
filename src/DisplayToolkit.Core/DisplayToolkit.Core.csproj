<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DisplayToolkit.Core</RootNamespace>
    <!-- Required by source-generated P/Invoke (LibraryImport). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DisplayToolkit.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- DDC/CI trouble goes to the app's log, which users attach to bug reports. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
